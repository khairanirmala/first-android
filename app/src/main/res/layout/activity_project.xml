<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">


    <TextView
        android:id="@+id/textJudulProject"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Proyek Unggulan"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />
    <ImageView
        android:id="@+id/imageProject"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:src="@drawable/foto_project"
        android:scaleType="centerCrop"
        android:contentDescription="Gambar Proyek"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/textJudulProject"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <TextView
        android:id="@+id/textDeskripsiProject"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Ini adalah salah satu proyek yang pernah saya buat untuk membantu pengguna dalam..."
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/imageProject"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <Button
        android:id="@+id/buttonGithub"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Lihat di GitHub"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/textDeskripsiProject"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <Button
        android:id="@+id/buttonKembaliProject"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Kembali"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/buttonGithub"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>

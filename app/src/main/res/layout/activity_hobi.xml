<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">


    <TextView
        android:id="@+id/textJudulHobi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kegiatan Favoritku"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />
    <ImageView
        android:id="@+id/imageHobi"
        android:layout_width="0dp"
        android:layout_height="250dp"
        android:src="@drawable/foto_hobi"
        android:scaleType="centerCrop"
        android:contentDescription="Foto Hobi"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/textJudulHobi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <TextView
        android:id="@+id/textDeskripsiHobi"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Hobi saya adalah membaca novel, hunting foto aesthetic, dan belajar hal-hal baru. Kegiatan ini membantu saya menambah pengetahuan dan merefresh pikiran."
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/imageHobi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <Button
        android:id="@+id/buttonKembaliHobi"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Kembali"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/textDeskripsiHobi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
